    srcs = [
        "filewatcher.go",
        "filewatcher_darwin.go",
        "poller.go",
    ],
    importpath = "namespacelabs.dev/foundation/internal/filewatcher",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/console",
        "@com_github_fsnotify_fsnotify//:fsnotify",
        "@dev_namespacelabs_go_filenotify//:go-filenotify",
    ] + select({
