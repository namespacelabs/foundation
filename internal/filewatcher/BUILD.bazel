            "//internal/fnerrors",
            "//internal/uniquestrings",
            "@com_github_fsnotify_fsevents//:fsevents",
            "@org_uber_go_atomic//:atomic",
        ],
        "@rules_go//go/platform:ios": [
            "//internal/fnerrors",
            "//internal/uniquestrings",
            "@com_github_fsnotify_fsevents//:fsevents",
            "@org_uber_go_atomic//:atomic",
        ],
        "//conditions:default": [],
